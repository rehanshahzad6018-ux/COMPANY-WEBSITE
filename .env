# ============================================================
#  TECHNO AI Platform — Environment Variables
#  The system works right now with NO key (smart fallback).
#  Add any ONE free key below to enable real AI responses.
# ============================================================

# ── FREE OPTION 1: Groq (FASTEST — Llama 3, no credit card) ──
# Sign up free at: console.groq.com → API Keys → Create key
# Free tier: 14,400 requests/day
GROQ_API_KEY=your_groq_key_here

# ── FREE OPTION 2: Google Gemini (easiest, just needs Google account) ──
# Get free key at: aistudio.google.com → Get API key → Create
# Free tier: 1,500 requests/day
GEMINI_API_KEY=your_free_gemini_key_here

# ── PAID: OpenAI GPT-4o (best quality, needs billing) ────────
# Get key at: platform.openai.com → API keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Twilio (for WhatsApp + Voice — optional) ─────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+14155551234
TRANSFER_NUMBER=+14155559876

# ── Admin panel password (must match PASS in admin.html) ─────
ADMIN_SECRET=ddUg-93XtwRZ_IGjwVpOn4iO9QrP1DBg

# ── OpenRouter (primary AI provider for website chat) ────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Server ───────────────────────────────────────────────────
PORT=3000
