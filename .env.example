# Copy this file to .env and fill in real values. NEVER commit the real .env.
# .env.example must contain placeholders ONLY — no real secrets.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

PORT=3000

# Admin panel credentials. ADMIN_SECRET must be long & random (min 16 chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_USER=your_admin_username
ADMIN_SECRET=your_long_random_secret_here

# Database (if used)
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
