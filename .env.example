# ============================================================
#  TECHNO AI Platform — Environment Variables
#  Copy to .env and fill in your values
# ============================================================

# ── CENTRAL AI BRAIN ─────────────────────────────────────────
# Primary AI: OpenAI GPT-4o (best quality)
# Get key at: platform.openai.com → API Keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Fallback AI: Google Gemini (free)
# Get key at: aistudio.google.com → Get API key
GEMINI_API_KEY=your_free_gemini_key_here

# ── TWILIO (WhatsApp + Voice) ─────────────────────────────────
# Sign up at twilio.com — free trial included
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14155551234

# ── PHASE 1: WhatsApp Agent ───────────────────────────────────
# Twilio WhatsApp Sandbox webhook:
#   POST https://YOUR_DOMAIN/whatsapp/incoming
#
# Setup: console.twilio.com → Messaging → Try WhatsApp
#   Sandbox URL: https://YOUR_DOMAIN/whatsapp/incoming
#
# Production: Apply for WhatsApp Business API in Twilio Console

# ── PHASE 2: Email Agent ──────────────────────────────────────
# EmailJS (browser-based sending, no backend needed)
# Get at: emailjs.com → Account → API Keys
EMAILJS_PUBLIC_KEY=your_emailjs_key
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_NOTIFY=template_xxxxxxx
EMAILJS_TEMPLATE_REPLY=template_xxxxxxx

# ── PHASE 3: Voice Agent ──────────────────────────────────────
# Transfer number — real phone for human handoff
TRANSFER_NUMBER=+14155559876

# Twilio Voice webhook (set in Twilio Console):
#   Incoming: POST https://YOUR_DOMAIN/voice/incoming
#   Status:   POST https://YOUR_DOMAIN/voice/status

# ── SERVER ───────────────────────────────────────────────────
PORT=3000

# ── LOCAL TESTING ─────────────────────────────────────────────
# Expose localhost publicly with ngrok:
#   npx ngrok http 3000
# Then use the https://xxx.ngrok.io URL in all Twilio webhooks
