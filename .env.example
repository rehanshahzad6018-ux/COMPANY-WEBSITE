# ============================================================
#  TECHNO AI Platform — Environment Variables
#  Copy to .env and fill in your values
# ============================================================

# ── CENTRAL AI BRAIN ─────────────────────────────────────────
# Primary AI: OpenAI GPT-4o (best quality)
# Get key at: platform.openai.com → API Keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Fallback AI: Google Gemini (free)
# Get key at: aistudio.google.com → Get API key
GEMINI_API_KEY=your_free_gemini_key_here

# ── Email Agent ───────────────────────────────────────────────
# EmailJS (browser-based sending, no backend needed)
# Get at: emailjs.com → Account → API Keys
EMAILJS_PUBLIC_KEY=your_emailjs_key
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_NOTIFY=template_xxxxxxx
EMAILJS_TEMPLATE_REPLY=template_xxxxxxx

# ── SERVER ───────────────────────────────────────────────────
PORT=3000


# ── CONTACT FORM EMAIL (server-side only — never exposed to the browser) ──
# Where contact-form enquiries are delivered
CONTACT_TO=cgwofficialai@gmail.com
MAIL_FROM_NAME=CGW Website
MAIL_TIMEZONE=Asia/Karachi

# Option A — Gmail SMTP (recommended on a Node host: Render, Railway, VPS)
#   1. Google Account > Security > turn on 2-Step Verification
#   2. Security > App passwords > create one for "Mail"
#   3. Paste the 16-character password into SMTP_PASS (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cgwofficialai@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# Option B — Resend HTTP API (use when the host blocks outbound SMTP ports)
#   Key from resend.com. RESEND_FROM must use a domain verified in Resend;
#   the default shared sender only delivers to your own address.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=CGW Website <noreply@yourdomain.com>

# ── ADMIN PANEL (admin.html) ─────────────────────────────────
# ADMIN_PASSWORD is what you type on the login screen.
# ADMIN_SECRET is the API token the server hands out after a correct login —
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without ADMIN_SECRET the admin API stays disabled (503).
ADMIN_USER=admin
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SECRET=generate_a_long_random_string

# ── AI CHATBOT MODEL ─────────────────────────────────────────
# Google retires model names regularly. gemini-1.5-flash is gone; use a
# current one. The "-lite" models answer directly, the thinking models can
# spend the whole token budget on thoughts and return nothing.
GEMINI_MODEL=gemini-3.5-flash-lite
